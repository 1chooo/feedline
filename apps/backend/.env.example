# Export these variables in the shell/container before running Go commands.
# PostgreSQL (default); DATABASE_URL retains PostgreSQL TLS connection options.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://ad:ad@localhost:5432/ad_service?sslmode=disable

# To use a local file instead, set DATABASE_DRIVER=sqlite. DATABASE_URL is
# ignored by SQLite. Server and seed commands must share this path.
DATABASE_SQLITE_PATH=./data/stream.db

STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
APP_ENV=development
PAYMENTS_DRIVER=manual
PORT=8080
